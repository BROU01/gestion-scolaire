# ============================================
# Gestion Scolaire — Configuration
# Copier ce fichier en .env et ajuster
# ============================================

# Port du serveur (défaut: 3001)
PORT=3001

# Clé secrète JWT (OBLIGATOIRE en production)
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=gestion-scolaire-dev-secret-key-2026

# Environnement: development | production | test
NODE_ENV=development

# Origine CORS (en production, mettre le domaine exact)
CORS_ORIGIN=*

# Rate limiting global (requêtes par 15 min, défaut: 100)
RATE_LIMIT_MAX=100

# Rate limiting login (tentatives par 15 min, défaut: 20)
# Augmenter si plusieurs utilisateurs partagent la même IP
RATE_LIMIT_AUTH_MAX=20
